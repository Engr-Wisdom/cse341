    "/transactions": {
      "get": {
        "description": "Get all transactions",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a new transaction",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["amount", "date", "paymentMethod", "invoiceNumber"],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0.01,
                  "example": 1500.50
                },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T00:00:00Z"
                },
                "paymentMethod": {
                  "type": "string",
                  "enum": ["Cash", "Card", "Bank"],
                  "example": "Cash"
                },
                "status": {
                  "type": "string",
                  "enum": ["Pending", "Completed", "Failed"],
                  "example": "Pending"
                },
                "invoiceNumber": {
                  "type": "string",
                  "example": "INV-1001"
                },
                "notes": {
                  "type": "string",
                  "example": "Payment for order #1234"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Transaction created successfully"
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Amount must be a number"
                }
              }
            }
          }
        }
      }
    },

    "/transactions/{id}": {
      "get": {
        "description": "Get transaction by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "description": "Update transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "example": "txn_123456"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0.01,
                  "example": 2500.75
                },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T00:00:00Z"
                },
                "paymentMethod": {
                  "type": "string",
                  "enum": ["Cash", "Card", "Bank"],
                  "example": "Card"
                },
                "status": {
                  "type": "string",
                  "enum": ["Pending", "Completed", "Failed"],
                  "example": "Completed"
                },
                "invoiceNumber": {
                  "type": "string",
                  "example": "INV-1001"
                },
                "notes": {
                  "type": "string",
                  "example": "Updated payment for order #1234"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T12:00:00Z"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Transaction updated successfully"
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Payment Method must be Cash, Card, or Bank"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Transaction not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "description": "Delete transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not found" }
        }
      }
    },

    "/accounts": {
      "get": {
        "description": "Get all accounts",
        "responses": {
          "200": { "description": "OK" }
        }
      },
    "post": {
      "description": "Create a new account",
      "parameters": [
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["userId", "bankName", "accountType"],
            "properties": {
              "userId": {
                "type": "string",
                "example": "user_123456"
              },
              "bankName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 50,
                "example": "PayPal"
              },
              "accountType": {
                "type": "string",
                "enum": ["savings", "current", "wallet"],
                "example": "savings"
              },
              "balance": {
                "type": "number",
                "minimum": 0,
                "example": 5000
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3,
                "example": "USD"
              }
            }
          }
        }
      ],
      "responses": {
        "201": {
          "description": "Created successfully",
          "schema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Account created successfully"
              },
              "data": {
                "type": "object"
              }
            }
          }
        },
        "400": {
          "description": "Validation error",
          "schema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Bank name must be at least 2 characters"
              }
            }
          }
        }
      }
    }
    },

    "/accounts/{id}": {
      "get": {
        "description": "Get account by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "description": "Update account fields",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "example": "acc_123456"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "balance": {
                  "type": "number",
                  "minimum": 0,
                  "example": 7500
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3,
                  "example": "USD"
                },
                "accountType": {
                  "type": "string",
                  "enum": ["savings", "current", "wallet"],
                  "example": "savings"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Account updated successfully"
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "At least one field (balance, currency, accountType) is required to update"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Account not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "description": "Delete account",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not found" }
        }
      }
    },

    "/users": {
      "get": {
        "description": "Get all users",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["firstName", "lastName", "email", "password", "address"],
              "properties": {
                "firstName": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 50,
                  "example": "John"
                },
                "lastName": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 50,
                  "example": "Doe"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "example": "john@example.com"
                },
                "password": {
                  "type": "string",
                  "minLength": 6,
                  "example": "password123"
                },
                "role": {
                  "type": "string",
                  "enum": ["admin", "user"],
                  "example": "user"
                },
                "phone": {
                  "type": "string",
                  "pattern": "^[0-9+]{10,15}$",
                  "example": "+2348012345678"
                },
                "address": {
                  "type": "string",
                  "example": "Port Harcourt, Nigeria"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "User created successfully"
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "First name must be at least 3 characters"
                }
              }
            }
          }
        }
      }
    },

