    "/cards": {
      "get": {
        "description": "Get all cards",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "description": "Create a new card (accountId must exist)",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["accountId", "name", "cardType", "brand"],
              "properties": {
                "accountId": {
                  "type": "string",
                  "example": "acc_123456"
                },
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 50,
                  "example": "Wisdom John"
                },
                "cardType": {
                  "type": "string",
                  "enum": ["debit", "credit", "virtual"],
                  "example": "debit"
                },
                "brand": {
                  "type": "string",
                  "enum": ["visa", "mastercard"],
                  "example": "visa"
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "blocked"],
                  "example": "active"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Card created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Card created successfully"
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Card type must be one of: debit, credit, virtual"
                }
              }
            }
          },
          "404": {
            "description": "Account does not exist",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Account not found"
                }
              }
            }
          }
        }
      }
    },
