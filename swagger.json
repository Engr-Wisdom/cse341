{
  "swagger": "2.0",
  "info": {
    "title": "Users & Transactions API",
    "description": "API documentation for Contacts and Transactions",
    "version": "1.0.0"
  },
  "host": "cse341-b1le.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],

  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter token as: Bearer <your_token>"
    }
  },

  "security": [
    {
      "Bearer": []
    }
  ],

  "paths": {
    "/": {
      "get": {
        "description": "Test route",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },

    "/contacts": {
      "get": {
        "description": "Get all contacts",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a contact",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["firstName", "lastName", "email"],
              "properties": {
                "firstName": { "type": "string", "example": "" },
                "lastName": { "type": "string", "example": "" },
                "email": { "type": "string", "example": "" },
                "favoriteColor": { "type": "string", "example": "" },
                "birthday": { "type": "string", "example": "" },
                "phone": { "type": "string", "example": ""},
                "address": { "type": "string", "example": ""}
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created successfully" }
        }
      }
    },

    "/contacts/{id}": {
      "get": {
        "description": "Get contact by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "put": {
        "description": "Update contact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string", "example": "" },
                "lastName": { "type": "string", "example": "" },
                "email": { "type": "string", "example": "" },
                "favoriteColor": { "type": "string", "example": "" },
                "birthday": { "type": "string", "example": "" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" }
        }
      },
      "delete": {
        "description": "Delete contact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" }
        }
      }
    },

    "/transactions": {
      "get": {
        "description": "Get all transactions",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a new transaction",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["amount", "date"],
              "properties": {
                "amount": { "type": "number", "example": 0 },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T00:00:00Z"
                },
                "paymentMethod": {
                  "type": "string",
                  "example": "Cash"
                },
                "status": { "type": "string", "example": "Pending" },
                "invoiceNumber": {
                  "type": "string",
                  "example": ""
                },
                "notes": {
                  "type": "string",
                  "example": ""
                }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },

    "/transactions/{id}": {
      "get": {
        "description": "Get transaction by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "description": "Update transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "amount": { "type": "number", "example": 0 },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T00:00:00Z"
                },
                "paymentMethod": {
                  "type": "string",
                  "example": "Card"
                },
                "status": { "type": "string", "example": "Paid" },
                "invoiceNumber": {
                  "type": "string",
                  "example": ""
                },
                "notes": {
                  "type": "string",
                  "example": ""
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-03-31T12:00:00Z"
                }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "description": "Delete transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not found" }
        }
      }
    },

    "/accounts": {
      "get": {
        "description": "Get all accounts",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a new account",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["userId", "bankName", "accountNumber", "accountType"],
              "properties": {
                "userId": { "type": "string", "example": "" },
                "bankName": { "type": "string", "example": "Paypal" },
                "accountType": { "type": "string", "example": "savings" },
                "balance": { "type": "number", "example": 0 },
                "currency": { "type": "string", "example": "USD" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },

    "/accounts/{id}": {
      "get": {
        "description": "Get account by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "description": "Update account fields",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "balance": { "type": "number", "example": 0 },
                "currency": { "type": "string", "example": "USD" },
                "accountType": { "type": "string", "example": "savings" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "description": "Delete account",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not found" }
        }
      }
    },

    "/users": {
      "get": {
        "description": "Get all users",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "description": "Create a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["firstName", "lastName", "email", "password"],
              "properties": {
                "firstName": { "type": "string", "example": "John" },
                "lastName": { "type": "string", "example": "Doe" },
                "email": { "type": "string", "example": "john@example.com" },
                "password": { "type": "string", "example": "password123" },
                "role": { "type": "string", "example": "user" },
                "phone": { "type": "string", "example": "+2348012345678" },
                "address": { "type": "string", "example": "Port Harcourt, Nigeria" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },

    "/users/{id}": {
      "get": {
        "description": "Get user by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "description": "Update user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string", "example": "John" },
                "lastName": { "type": "string", "example": "Doe" },
                "email": { "type": "string", "example": "john@example.com" },
                "role": { "type": "string", "example": "admin" },
                "phone": { "type": "string", "example": "+2348012345678" },
                "address": { "type": "string", "example": "Lagos, Nigeria" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "User updated successfully" },
          "400": { "description": "Validation error" },
          "404": { "description": "User not found" }
        }
      },
      "delete": {
        "description": "Delete user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "User deleted successfully" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/cards": {
      "get": {
        "description": "Get all cards",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "description": "Create a new card (accountId must exist)",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["accountId", "name", "cardType", "brand"],
              "properties": {
                "accountId": { "type": "string", "example": "" },
                "name": { "type": "string", "example": "" },
                "cardType": { "type": "string", "example": "debit" },
                "brand": { "type": "string", "example": "visa" },
                "status": { "type": "string", "example": "active" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Card created successfully" },
          "400": { "description": "Validation error" },
          "404": { "description": "Account does not exist" }
        }
      }
    },
    "/cards/{id}": {
      "get": {
        "description": "Get card by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Card not found" }
        }
      },
      "put": {
        "description": "Update card",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "example": "Wisdom Updated"},
                "cardType": { "type": "string", "example": "debit" },
                "brand": { "type": "string", "example": "visa" },
                "status": { "type": "string", "example": "active" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" },
          "400": { "description": "Card not found" }
        }
      },
      "delete": {
        "description": "Delete card",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "400": { "description": "Card not found" }
        }
      }
    }
  }
}